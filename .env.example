# docreader configuration. Copy this file to .env (git-ignored).
# Only the broker container reads it. The docreader server reads BROKER_ADMIN_TOKEN only.

# --- Required -------------------------------------------------------------
# OpenCode Go subscription key: https://opencode.ai/docs/go/
OPENCODE_API_KEY=
# Secret for the broker admin API. Make one with: openssl rand -hex 32
BROKER_ADMIN_TOKEN=

# --- Optional: Google tools (OCR, layout parsing, chart reading) -----------
# Leave empty to run without them. Put the credentials file at ./secrets/gcp-key.json.
GCP_PROJECT=
# Must match the location of the processors below (eu or us).
DOCAI_LOCATION=eu
DOCAI_OCR_PROCESSOR_ID=
DOCAI_LAYOUT_PROCESSOR_ID=
# Use an EU region for EU processing, if your project serves the model there.
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
